<type>
	<array name="SeekPoints">
		<iterate type="until-length"/>
		<element-name>
			<string>SeekPoint</string>
		</element-name>
		<element-type>
			<type>
				<sequence>
					<field>
						<name>
							<string>SampleNumberOfFirstSampleInTargetFrame</string>
						</name>
						<type-reference>
							<part>Number</part>
							<part>Integer</part>
							<part>Unsigned</part>
							<part>64Bit_BigEndian</part>
						</type-reference>
					</field>
					<field>
						<name>
							<string>ByteOffsetOfTargetFrame</string>
						</name>
						<type-reference>
							<part>Number</part>
							<part>Integer</part>
							<part>Unsigned</part>
							<part>64Bit_BigEndian</part>
						</type-reference>
					</field>
					<field>
						<name>
							<string>NumberOfSamplesInTargetFrame</string>
						</name>
						<type-reference>
							<part>Number</part>
							<part>Integer</part>
							<part>Unsigned</part>
							<part>16Bit_BigEndian</part>
						</type-reference>
					</field>
				</sequence>
			</type>
		</element-type>
	</array>
</type>
