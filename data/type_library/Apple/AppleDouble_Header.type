<type>
	<sequence>
		<field>
			<name>
				<string>MagicNumber</string>
			</name>
			<type-reference>
				<part>Number</part>
				<part>Integer</part>
				<part>Unsigned</part>
				<part>32Bit_BigEndian</part>
			</type-reference>
			<verification>
				<equals>
					<data-reference root="current"/>
					<unsigned-integer-32bit>333319</unsigned-integer-32bit>
				</equals>
			</verification>
		</field>
		<field>
			<name>
				<string>VersionNumber</string>
			</name>
			<type-reference>
				<part>Number</part>
				<part>Integer</part>
				<part>Unsigned</part>
				<part>32Bit_BigEndian</part>
			</type-reference>
			<verification>
				<equals>
					<data-reference root="current"/>
					<unsigned-integer-32bit>131072</unsigned-integer-32bit>
				</equals>
			</verification>
		</field>
		<field>
			<name>
				<string>Filler</string>
			</name>
			<type-reference>
				<part>Data</part>
				<part>Unset_EndedByLength</part>
			</type-reference>
			<length>
				<bytes>
					<unsigned-integer-64bit>16</unsigned-integer-64bit>
				</bytes>
				<bits>
					<unsigned-integer-64bit>0</unsigned-integer-64bit>
				</bits>
			</length>
		</field>
		<field>
			<name>
				<string>NumberOfEntries</string>
			</name>
			<type-reference>
				<part>Number</part>
				<part>Integer</part>
				<part>Unsigned</part>
				<part>16Bit_BigEndian</part>
			</type-reference>
		</field>
		<array name="EntryDescriptors">
			<iterate type="number-of-elements">
				<unsigned-integer-64bit>
					<data-reference root="type">
						<field>NumberOfEntries</field>
					</data-reference>
				</unsigned-integer-64bit>
			</iterate>
			<element-name>
				<string>EntryDescriptor</string>
			</element-name>
			<element-type>
				<type-reference>
					<part>Apple</part>
					<part>AppleDouble_EntryDescriptor</part>
				</type-reference>
			</element-type>
		</array>
	</sequence>
</type>
