<type>
	<array name="Documents">
		<iterate type="until-length"/>
		<element-name>
			<string>Document</string>
		</element-name>
		<element-type>
			<type>
				<sequence>
					<field>
						<name>
							<string>EBML</string>
						</name>
						<type-reference>
							<part>EBML</part>
							<part>Element</part>
						</type-reference>
						<verification>
							<equals>
								<data-reference root="current">
									<field>ID</field>
								</data-reference>
								<unsigned-integer-8bit-buffer>
									<unsigned-integer-8bit>26</unsigned-integer-8bit>
									<unsigned-integer-8bit>69</unsigned-integer-8bit>
									<unsigned-integer-8bit>223</unsigned-integer-8bit>
									<unsigned-integer-8bit>163</unsigned-integer-8bit>
								</unsigned-integer-8bit-buffer>
							</equals>
						</verification>
					</field>
					<field>
						<name>
							<data-reference root="current">
								<field>ID</field>
								<tag>name</tag>
								<fallback>
									<string>Element</string>
								</fallback>
							</data-reference>
						</name>
						<type-reference>
							<part>EBML</part>
							<part>Element</part>
						</type-reference>
					</field>
				</sequence>
			</type>
		</element-type>
	</array>
</type>
